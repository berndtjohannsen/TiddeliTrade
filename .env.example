# IG API credentials (optional if using config.json Settings UI)
# Get API key from https://labs.ig.com/
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=

# Server port (default 3000)
PORT=3000

# Windows / SSL inspection: if IG login shows "fetch failed", Node 22+ can use the OS cert store:
# NODE_OPTIONS=--use-system-ca
